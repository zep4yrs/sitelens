# 复制为 .env 并填入本机 PostgreSQL 连接信息
# 仅 `sitelens migrate-pg`（JSON → PostgreSQL 迁移）读取这些变量；
# 引擎/API 的存储由配置文件 .sitelens.yml 的 store.driver / store.dsn 决定。
SLENS_DB_HOST=127.0.0.1
SLENS_DB_PORT=5432
SLENS_DB_USER=postgres
SLENS_DB_PASSWORD=your-password-here
SLENS_DB_NAME=sitelens

# 可选：设置后 /api/* 需要 X-Token 请求头
# （等价于命令行 -api-token 或 .sitelens.yml 的 web.api_token；三处任一非空即生效）
# SLENS_API_TOKEN=

# 关于「关闭情报库自动更新」：当前**没有**对应环境变量（此前的 SLENS_AUTO_UPDATE
# 从未被任何代码读取，已删除）。真正的开关是配置文件 .sitelens.yml 的
# intel.update_hours（单位小时，默认 24）；注意 0 或负值会回退为默认 24，
# 即**不支持「0 = 关闭」**。确需完全离线时，请在网络层阻断出网
# （例如容器 `--network none` 或出站防火墙策略）。
